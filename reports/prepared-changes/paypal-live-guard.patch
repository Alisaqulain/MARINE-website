Prepared 9 Nov 2026, NOT APPLIED. Needs client approval.
Blocks creating or capturing PayPal orders in LIVE mode outside production (NODE_ENV !== "production"),
unless PAYPAL_ALLOW_LIVE_OUTSIDE_PRODUCTION=1 is set deliberately. Production (next start, NODE_ENV=production)
is unaffected. Apply from the project root: git apply reports/prepared-changes/paypal-live-guard.patch

diff --git a/lib/paypal.ts b/lib/paypal.ts
index 984de00..7549a2c 100644
--- a/lib/paypal.ts
+++ b/lib/paypal.ts
@@ -13,6 +13,17 @@ export function paypalMode() {
   return (process.env.PAYPAL_MODE ?? "sandbox").trim().toLowerCase() === "live" ? "live" : "sandbox";
 }
 
+/** A local or development server must not charge real cards: live mode is refused outside production. */
+function assertPayPalModeAllowed() {
+  if (
+    paypalMode() === "live" &&
+    process.env.NODE_ENV !== "production" &&
+    process.env.PAYPAL_ALLOW_LIVE_OUTSIDE_PRODUCTION !== "1"
+  ) {
+    throw new Error("PayPal is in LIVE mode outside production. Use PAYPAL_MODE=sandbox with sandbox credentials for development.");
+  }
+}
+
