+  const wabaId = val(env, "WHATSAPP_BUSINESS_ACCOUNT_ID");
+  const missing = [
+    ...(token ? [] : ["WHATSAPP_ACCESS_TOKEN"]),
+    ...(phoneNumberId ? [] : ["WHATSAPP_PHONE_NUMBER_ID"]),
