# Marina Muse — production environment TEMPLATE (names and placeholders only).
# Generated from lib/ai/env-registry.ts by reports/evidence/security/gen-prod-env-template.mjs.
# Contains NO real value. Fill on the production server only (.env.production.local), never in a repository,
# chat, AI tool or another project's folder. Every secret marked [secret] must be a NEW value where the
# security report recommends rotation (MongoDB user, and any secret that was in the exposed .env copy).
# NODE_ENV=production is set by `next start` / the process manager, not here.


# ── Database (MongoDB Atlas) ──
# Copy the SRV connection string and insert the database user's password. [required, secret, platform]
MONGODB_URI=<secret: set on server>
# Only if SRV DNS fails on the server; overrides MONGODB_URI. [optional, secret, platform]
# MONGODB_URI_STANDARD=<secret: set on server>
# Database name, e.g. marina_muse. [required, platform]
MONGODB_DB_NAME=<set on server>
# 1 to prefer IPv4 (recommended on the VPS). [optional, platform]
# MONGODB_PREFER_IPV4=
# Number of app processes sharing the Atlas connection limit (e.g. 2 under PM2). [optional, platform]
# MONGODB_NODE_PROCESSES=
# Connections reserved for other clients (default 40). [optional, platform]
# MONGODB_EXTERNAL_CLIENTS=
# Override the per-process pool size. [optional, platform]
# MONGODB_MAX_POOL_SIZE=
# Total Atlas connection budget (advanced). [optional, platform]
# MONGODB_CONNECTION_BUDGET=
# Advanced connection mode switch (1/0). Leave unset unless troubleshooting. [optional, platform]
# MONGODB_DIRECT=
# 1 = use SRV only (advanced). [optional, platform]
# MONGODB_SRV_ONLY=
# 1/0 to force or skip the SRV fallback (advanced). [optional, platform]
# MONGODB_SKIP_SRV_FALLBACK=
# 0 disables the Stable API declaration (advanced). [optional, platform]
# MONGODB_SERVER_API=
# 1/0 Node autoSelectFamily for IPv4/IPv6 (advanced). [optional, platform]
# MONGODB_AUTO_SELECT_FAMILY=
# 1 forces IPv4 lookups (advanced). [optional, platform]
# MONGODB_FORCE_IPV4=
# Only for direct-shard connections (advanced). [optional, platform]
# MONGODB_REPLICA_SET=

# ── Site & sign-in ──
# Long random string. Also encrypts the stored WhatsApp token — changing it makes that token unreadable. [required, secret, platform/whatsapp]
AUTH_SECRET=<secret: set on server>
# Full site URL, e.g. https://marinamuseinternational.com (no trailing characters). [required, platform]
AUTH_URL=<set on server>
# Same as AUTH_URL. [required, platform]
NEXTAUTH_URL=<set on server>
# Public site URL used for absolute links, feeds and webhooks. [optional, platform/growth/voice]
# NEXT_PUBLIC_SITE_URL=
# Web OAuth client for “Sign in with Google”. [optional, platform]
# GOOGLE_CLIENT_ID=
# Client secret of that OAuth client. [optional, secret, platform]
# GOOGLE_CLIENT_SECRET=<secret: set on server>
# Comma-separated admin emails. [required, platform]
ADMIN_EMAILS=<set on server>
# Strong admin password. Never reuse the sample value. [required, secret, platform]
ADMIN_PASSWORD=<secret: set on server>
# Shop time zone for sale dates, default +05:30 (India). [optional, platform/growth]
# NEXT_PUBLIC_SHOP_UTC_OFFSET=
# Shown on the site (currently read from lib/company). [optional, platform]
# CONTACT_EMAILS=

# ── Email & owner alerts ──
# e.g. mail.marinamuseinternational.com [required-for-feature, platform/chat/voice/growth]
SMTP_HOST=<set on server>
# 587 (STARTTLS) or 465 (SSL). [required-for-feature, platform/chat/voice/growth]
SMTP_PORT=<set on server>
# Mailbox address used to send. [required-for-feature, platform/chat/voice/growth]
SMTP_USER=<set on server>
# Password for SMTP_USER. [required-for-feature, secret, platform/chat/voice/growth]
SMTP_PASS=<secret: set on server>
# Kept for compatibility; the sender is set in lib/password-otp-email. [optional, platform]
# SMTP_FROM=
# Who receives lead/missed-call alerts and the daily report (defaults to ADMIN_EMAILS). [optional, chat/voice/whatsapp/growth]
# OWNER_ALERT_EMAILS=
# Lead score (1–100) that alerts the owner. Default 81. [optional, chat/voice/whatsapp]
# AI_OWNER_ALERT_SCORE=
# Estimated deal value (USD) that alerts the owner. Default 5000. [optional, chat/voice/whatsapp]
# AI_OWNER_ALERT_VALUE_USD=
# Optional: order confirmation emails via Resend. [optional, secret, platform]
# RESEND_API_KEY=<secret: set on server>
# Sender for order emails sent through Resend. [optional, platform]
# ORDER_EMAIL_FROM=

# ── Payments & shipping (existing store) ──
# Client ID of the live (or sandbox) app. [required-for-feature, platform]
PAYPAL_CLIENT_ID=<set on server>
# Secret of that app. [required-for-feature, secret, platform]
PAYPAL_CLIENT_SECRET=<secret: set on server>
# sandbox or live. [required-for-feature, platform]
PAYPAL_MODE=live
# Webhook ID shown after creating it. [required-for-feature, platform]
PAYPAL_WEBHOOK_ID=<set on server>
# Only if Razorpay checkout is used. [optional, platform]
# RAZORPAY_KEY_ID=
# Key secret. [optional, secret, platform]
# RAZORPAY_KEY_SECRET=<secret: set on server>
# Label-portal login email. [required-for-feature, platform]
SHIPGLOBAL_EMAIL=<set on server>
# Password for SHIPGLOBAL_EMAIL. [required-for-feature, secret, platform]
SHIPGLOBAL_PASSWORD=<secret: set on server>
# e.g. DHLECS. [optional, platform]
# SHIPGLOBAL_SERVICE=
# Default https://labels.shipglobal.in/api/v1. [optional, platform]
# SHIPGLOBAL_API_BASE=
# HSN code for customs (optional). [optional, platform]
# SHIPGLOBAL_HSN=
# 1 for CSB-V shipments (optional). [optional, platform]
# SHIPGLOBAL_CSB5=
# EU IOSS number (optional). [optional, platform]
# SHIPGLOBAL_IOSS=
# Seller first name on labels (optional). [optional, platform]
# SHIPGLOBAL_SELLER_FIRST=
# Seller last name on labels (optional). [optional, platform]
# SHIPGLOBAL_SELLER_LAST=
# Remote image host exposing POST /upload; empty = save under public/uploads. [optional, platform]
# KVM2_UPLOAD_URL=
# Bearer token for that upload endpoint. [optional, secret, platform]
# KVM2_UPLOAD_TOKEN=<secret: set on server>

# ── Gemini (shared AI) ──
# Create an API key. A Gemini app/Pro subscription is not an API key. Enable billing for production quotas. [required, secret, chat/voice/growth/whatsapp]
GEMINI_API_KEY=<secret: set on server>
# Model id; default gemini-3.5-flash. gemini-2.5-flash is no longer available to new API users. [optional, chat/voice/growth/whatsapp]
# GEMINI_MODEL=
# Model(s) tried when GEMINI_MODEL times out, is overloaded, returns 404 or a long 429. Comma-separated; default gemini-3.5-flash, gemini-3.5-flash-lite. [optional, chat/voice/growth/whatsapp]
# GEMINI_FALLBACK_MODEL=
# Comma-separated agents to switch off: chat, voice, growth, whatsapp. Empty = all on. [optional, chat/voice/growth/whatsapp]
# AI_AGENTS_DISABLED=

# ── Scheduled jobs ──
# Send as Authorization: Bearer … from your scheduler to /api/ai/jobs (every 15 min) and /api/ai/report/daily (daily). [required, secret, chat/growth/whatsapp]
CRON_SECRET=<secret: set on server>

# ── Vapi (voice AI) ──
# Use the PRIVATE key, not the public key. [required-for-feature, secret, voice]
VAPI_API_KEY=<secret: set on server>
# Create an assistant, then Admin → Marina AI → Health → “Sync Vapi assistant”. [required-for-feature, voice]
VAPI_ASSISTANT_ID=<set on server>
# Vapi sends it as x-vapi-secret to /api/ai/voice/webhook (the Sync button configures this). [required-for-feature, secret, voice]
VAPI_WEBHOOK_SECRET=<secret: set on server>
# Create a byo-phone-number for your ExoPhone on the SIP trunk credential. [required-for-feature, voice]
VAPI_PHONE_NUMBER_ID=<set on server>
# BYO SIP trunk credential pointing at the Exotel gateway. [required-for-feature, voice]
VAPI_SIP_CREDENTIAL_ID=<set on server>
# true only after testing — enables owner-approved, billable callbacks. [optional, voice]
VAPI_OUTBOUND_ENABLED=false
# Gemini model for the assistant (defaults to GEMINI_MODEL). [optional, voice]
# VAPI_MODEL=
# https://api.vapi.ai (default) or https://api.eu.vapi.ai for EU orgs. [optional, voice]
# VAPI_API_BASE=
# Languages your voice/transcriber really supports, e.g. en,hi. [optional, voice]
# VOICE_LANGUAGES=
# Only for a non-Vapi provider using the generic HMAC webhook. [optional, voice]
# VOICE_PROVIDER=
# HMAC secret for the generic voice webhook (non-Vapi). [optional, secret, voice]
# VOICE_WEBHOOK_SECRET=<secret: set on server>

# ── Exotel (telephony) ──
# API key of your Exotel account. [required-for-feature, voice]
EXOTEL_API_KEY=<set on server>
# API token for that key. [required-for-feature, secret, voice]
EXOTEL_API_TOKEN=<secret: set on server>
# Your account SID. [required-for-feature, voice]
EXOTEL_ACCOUNT_SID=<set on server>
# api.in.exotel.com (Mumbai) or api.exotel.com (Singapore). [optional, voice]
# EXOTEL_SUBDOMAIN=
# Informational (e.g. Singapore or Mumbai). /test warns when it does not match EXOTEL_SUBDOMAIN. [optional, voice]
# EXOTEL_REGION=
# The ExoPhone customers call, in E.164 (+91…). Requires KYC. [required-for-feature, voice]
EXOTEL_PHONE_NUMBER=<set on server>
# Trunk routing the ExoPhone to <VAPI_SIP_CREDENTIAL_ID>.sip.vapi.ai. vSIP must be enabled by Exotel. [required-for-feature, voice]
EXOTEL_TRUNK_SID=<set on server>
# Put in the ExoPhone StatusCallback URL: /api/ai/voice/webhook?provider=exotel&token=… [required-for-feature, secret, voice]
EXOTEL_WEBHOOK_TOKEN=<secret: set on server>

# ── WhatsApp Cloud API ──
# Permanent System User token with whatsapp_business_messaging + whatsapp_business_management. Optional if Embedded Signup stored a token. [required-for-feature, secret, whatsapp]
WHATSAPP_ACCESS_TOKEN=<secret: set on server>
# Numeric phone-number ID (not the phone number). Filled automatically after a coexistence signup. [required-for-feature, whatsapp]
WHATSAPP_PHONE_NUMBER_ID=<set on server>
# Numeric WABA ID. [required-for-feature, whatsapp]
WHATSAPP_BUSINESS_ACCOUNT_ID=<set on server>
# Name of an APPROVED template for consented follow-ups outside the 24-hour window. [optional, whatsapp/chat]
# WHATSAPP_FOLLOWUP_TEMPLATE=
# Language code of that template, e.g. en or en_US. [optional, whatsapp]
# WHATSAPP_TEMPLATE_LANGUAGE=
# 1588276335845243 (supplied). [required-for-feature, whatsapp]
META_APP_ID=<set on server>
# Server only. Verifies webhook signatures and exchanges signup codes. [required-for-feature, secret, whatsapp]
META_APP_SECRET=<secret: set on server>
# Optional; defaults to META_APP_SECRET. [optional, secret, whatsapp]
# META_WEBHOOK_APP_SECRET=<secret: set on server>
# Any random string; Meta echoes it during webhook verification. [required-for-feature, secret, whatsapp]
META_WEBHOOK_VERIFY_TOKEN=<secret: set on server>
# Default v26.0. [optional, whatsapp]
# META_GRAPH_API_VERSION=

# ── WhatsApp coexistence ──
# 1760993601871515 (supplied): Embedded Signup v4 configuration. [required-for-feature, whatsapp]
META_CONFIG_ID=<set on server>
# true to open Embedded Signup (test mode needs WHATSAPP_COEXISTENCE_TEST_NUMBER). [optional, whatsapp]
WHATSAPP_COEXISTENCE_ENABLED=false
# true only after written approval to onboard the client's live number. [optional, whatsapp]
WHATSAPP_PRODUCTION_ONBOARDING_APPROVED=false
# true to let the AI send replies (inside the 24-hour window). [optional, whatsapp]
WHATSAPP_OUTBOUND_ENABLED=false

# ── Google Analytics & Search Console ──
# Paste the JSON (or base64 of it). Enable the Analytics Data API and Search Console API in that project. [required-for-feature, secret, growth]
GOOGLE_SERVICE_ACCOUNT_JSON=<secret: set on server>
# Alternative to the JSON: the account's email. [optional, growth]
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Alternative to the JSON: the PEM key with \n line breaks. [optional, secret, growth]
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=<secret: set on server>
# Numeric property ID (not the G- ID). Add the service-account email as Viewer in Property access management. [required-for-feature, growth]
GA4_PROPERTY_ID=<set on server>
# G-XXXXXXX, for server-side purchase events. [optional, growth]
# GA4_MEASUREMENT_ID=
# Secret for server-side purchase events. [optional, secret, growth]
# GA4_API_SECRET=<secret: set on server>
# Browser tag (loads after cookie consent). Rebuild after changing. [optional, growth]
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# sc-domain:marinamuseinternational.com (domain property) or https://marinamuseinternational.com/ (URL prefix). Add the service-account email under Settings → Users and permissions. [required-for-feature, growth]
SEARCH_CONSOLE_SITE_URL=<set on server>

# ── Development-only (must NOT be set in production) ──
# MONGODB_DEV_ALLOWED_HOSTS=
# PAYPAL_ALLOW_LIVE_OUTSIDE_PRODUCTION=
# SHIPGLOBAL_ALLOW_OUTSIDE_PRODUCTION=
# KVM2_UPLOAD_SKIP=
# GEMINI_TEST_API_KEY=
# GEMINI_TEST_PROJECT_CONFIRMED=
# WHATSAPP_COEXISTENCE_TEST_NUMBER=
# NEXT_PUBLIC_GA4_IN_DEVELOPMENT=
