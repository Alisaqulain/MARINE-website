# Marina Muse: ISOLATED TEST credentials (Phase 2 approved scope).
# Copy to .env.isolated-test.local (git-ignored) and fill ONLY with FRESH credentials issued for testing.
# Never paste a value that ever appeared in .env.local, an editor snapshot, a chat or another project.
# scripts/isolated-env.mjs loads ONLY this file for integration credentials; every integration value
# in .env.local is blanked first. All values below are intentionally empty.

# ── Chat & Sales (Gemini) — separate "Marina Muse Gemini Testing" project, no billing ──
GEMINI_TEST_API_KEY=
# Exact text: marina-muse-gemini-testing  (after you confirm the key belongs to that project)
GEMINI_TEST_PROJECT_CONFIRMED=

# ── Voice & Call (Vapi) — fresh private API key; no phone number, no calls, no publishing ──
VAPI_API_KEY=
# Optional: an assistant created for testing (leave empty to use none)
VAPI_ASSISTANT_ID=

# ── Growth & Revenue — dedicated read-only service account (JSON key, or base64 of it) ──
GOOGLE_SERVICE_ACCOUNT_JSON=
# Numeric GA4 property id (not the G- id)
GA4_PROPERTY_ID=
# sc-domain:marinamuseinternational.com  or  https://marinamuseinternational.com/
SEARCH_CONSOLE_SITE_URL=

# ── WhatsApp — ISOLATED Meta TEST app only (never the production app or business number) ──
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# Approved personal test number (digits with country code); the business number is refused by the code
WHATSAPP_COEXISTENCE_TEST_NUMBER=

# ── WhatsApp Direct Cloud API (C10) — Meta-provided TEST WABA and TEST number of the test app only ──
# The launcher forces WHATSAPP_INTEGRATION_MODE=direct and WHATSAPP_OUTBOUND_ENABLED=false.
# It refuses to start unless WHATSAPP_PHONE_NUMBER_ID equals WHATSAPP_TEST_PHONE_NUMBER_ID and
# WHATSAPP_BUSINESS_ACCOUNT_ID equals WHATSAPP_TEST_BUSINESS_ACCOUNT_ID exactly, and it refuses known production ids.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_BUSINESS_ACCOUNT_ID=
# Tester phones (digits with country code, comma-separated). Only used by a separately approved send test.
WHATSAPP_TEST_RECIPIENTS=

# Agents are OFF by default (fail-closed). To exercise an agent against the isolated server only, list it here,
# e.g. chat. Empty = every agent off. Never set in production; production also needs AI_AGENTS_PRODUCTION_APPROVED.
AI_AGENTS_ENABLED=
