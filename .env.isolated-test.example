# Isolated test credentials template. Copy to .env.isolated-test.local (git-ignored) and fill in
# ONLY Meta's TEST app / TEST phone number values. Never put the live number's IDs or token here.
# Only the names listed below are accepted by scripts/isolated-env.mjs.

# WhatsApp Direct Cloud API (Meta test number)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_BUSINESS_ACCOUNT_ID=
# Comma-separated tester numbers with country code, e.g. 919876543210
WHATSAPP_TEST_RECIPIENTS=

# Meta test app
META_APP_ID=
META_APP_SECRET=
