MONGODB_SRV_ONLY=
# [OPTIONAL] launch: no | rotate: no | secret: no
#   Advanced; leave unset.  ·  evidence: lib/atlas-connect.ts:16, lib/atlas-connect.ts:17
MONGODB_SKIP_SRV_FALLBACK=
# [OPTIONAL] launch: no | rotate: no | secret: no
#   Advanced; leave unset.  ·  evidence: lib/mongodb.ts:87
MONGODB_SERVER_API=
# [OPTIONAL] launch: no | rotate: no | secret: no
#   Advanced; leave unset.  ·  evidence: lib/atlas-connect.ts:86, lib/atlas-connect.ts:88
MONGODB_AUTO_SELECT_FAMILY=
