# ─── Development-only: MUST remain unset in production ───────────────────────────────
#   Skips the remote upload (development). Must be unset in production.  ·  evidence: lib/kvm-upload.ts:23, lib/kvm-upload.ts:23
# KVM2_UPLOAD_SKIP=
#   Set only by scripts/isolated-env.mjs for the isolated Phase 2 test environment (no fallback to the client's Meta app). Must be unset in production.  ·  evidence: lib/whatsapp/coexistence.ts:20
# MARINA_ISOLATED_TEST=
#   Development database-host allow-list (guard is inactive in production). Must be unset in production.  ·  evidence: lib/env-mongo-uri.ts:44
# MONGODB_DEV_ALLOWED_HOSTS=
#   The only number allowed for a test onboarding before approval. Leave unset in production.  ·  evidence: lib/whatsapp/coexistence.ts:156
# WHATSAPP_COEXISTENCE_TEST_NUMBER=
#   Overrides the live-mode guard outside production. Must be unset.  ·  evidence: lib/paypal.ts:21
# PAYPAL_ALLOW_LIVE_OUTSIDE_PRODUCTION=
#   Allows real bookings outside production. Must be unset.  ·  evidence: lib/shipglobal.ts:391
# SHIPGLOBAL_ALLOW_OUTSIDE_PRODUCTION=
#   Loads the GA4 tag in development builds. Must be unset.  ·  evidence: components/GoogleAnalytics.tsx:7
# NEXT_PUBLIC_GA4_IN_DEVELOPMENT=

