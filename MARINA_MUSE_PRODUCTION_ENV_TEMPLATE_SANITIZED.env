# =====================================================================================
# Marina Muse International: PRODUCTION environment TEMPLATE (SANITIZED, for client review)
# Generated 2026-11-10T16:37:53.702Z from a source-code audit (reports/MARINA_MUSE_ENV_TEMPLATE_AUDIT.md).
#
# * EVERY VALUE IS BLANK. This file contains no credential, token, password, key or URI.
# * Do not paste values into this file in a repository, chat, AI tool or e-mail. Real
#   values go only into .env.production.local on the production server (owner-only).
# * Secrets marked ROTATE=YES were exposed (security report, 10 Nov): issue NEW values.
# * This file is NOT loaded by Next.js (only .env, .env.local, .env.production[.local] are).
#
# Line format above each variable:
#   [CLASS] launch: <initial launch need> | rotate: <rotation> | secret: yes/no
#   purpose  ·  evidence: file:line
# CLASS: REQUIRED · CONDITIONAL (only when that integration is enabled) · OPTIONAL
# Development-only and RETIRED variables are listed at the end, commented out: do not set them.
# =====================================================================================

# ─── Core application and runtime ──────────────────────────────────────────
# [REQUIRED] launch: yes | rotate: no | secret: no
#   Must be `production`. Set by the process manager (PM2 `env` block, ecosystem.config.example.cjs) or `next start`; enables the production code paths (guards for dev-only behaviour switch off).  ·  evidence: components/GoogleAnalytics.tsx:6, lib/ai/health.ts:525, lib/ai/health.ts:526
#   (placeholder guidance: the value must be the word production; usually set by PM2, not here)
NODE_ENV=
# [OPTIONAL] launch: yes | rotate: no | secret: no
#   Port `next start` listens on (Next.js default 3000; the PM2 example uses 3002 for marina-muse behind nginx). Read by Next.js, not by app code.  ·  evidence: ecosystem.config.example.cjs (PM2 env), read by Next.js
PORT=
# [REQUIRED] launch: yes | rotate: no | secret: no
#   Public https site URL for absolute links, feed, sitemap and webhook URLs. Compiled into the client at build time: set BEFORE `npm run build`. Server code falls back to AUTH_URL (lib/auth-url.ts:50).  ·  evidence: app/layout.tsx:6, app/product/[slug]/layout.tsx:10, lib/ai/health.ts:520
NEXT_PUBLIC_SITE_URL=
# [OPTIONAL] launch: no | rotate: no | secret: no
#   Shop time zone for sale dates; default +05:30. Build-time.  ·  evidence: lib/sale-time.ts:6, lib/sale-time.ts:7
NEXT_PUBLIC_SHOP_UTC_OFFSET=
# [OPTIONAL] launch: yes | rotate: no | secret: no
#   Comma list of agents to switch off without a deploy. REQUIRED at launch (Phase 2 v1.1 section 7): all four agents stay disabled until each has its own written activation approval. The code treats an empty value as "all agents on" (lib/ai/agents.ts).  ·  evidence: lib/ai/agents.ts:19
AI_AGENTS_DISABLED=chat,voice,growth,whatsapp
# [OPTIONAL] launch: no | rotate: no | secret: no
#   FAIL-CLOSED allow-list (lib/ai/agents.ts). Leave EMPTY at launch: empty = every agent off. An agent runs in production only if listed here AND in AI_AGENTS_PRODUCTION_APPROVED AND not in AI_AGENTS_DISABLED. Any unknown value switches every agent off.
AI_AGENTS_ENABLED=
# [OPTIONAL] launch: no | rotate: no | secret: no
#   Production written-approval key per agent. Leave EMPTY until Ahmad approves an individual agent activation in writing.
AI_AGENTS_PRODUCTION_APPROVED=

