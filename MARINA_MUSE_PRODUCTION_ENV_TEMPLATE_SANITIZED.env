#   Per-process pool override.  ·  evidence: lib/mongodb-pool.ts:13
MONGODB_MAX_POOL_SIZE=
# [OPTIONAL] launch: no | rotate: no | secret: no
#   Total Atlas connection budget (advanced).  ·  evidence: lib/mongodb-pool.ts:18
MONGODB_CONNECTION_BUDGET=
# [OPTIONAL] launch: no | rotate: NEW VALUE (never reuse a development value) | secret: yes
#   Non-SRV connection string; only if SRV DNS fails on the server. Contains the same password: if used, it must carry the ROTATED password.  ·  evidence: lib/env-mongo-uri.ts:17, lib/mongodb.ts:184
