MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
# Optional: paste Atlas “Standard connection string” (Connect → Drivers) — overrides MONGODB_URI when set
# MONGODB_URI_STANDARD=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/?tls=true&replicaSet=...
MONGODB_DB_NAME=marina_muse
# Do NOT set MONGODB_DIRECT=0 on Linux VPS — it blocks direct shards (use SRV only if you set MONGODB_SRV_ONLY=1)
MONGODB_PREFER_IPV4=1
# Atlas M0 (~500 conn limit): PM2 apps that share MONGODB_URI (excelpro + marina-muse = 2; marina-upload usually 0).
MONGODB_NODE_PROCESSES=2
MONGODB_EXTERNAL_CLIENTS=40
# Optional override pool size per process (default: min(5, floor((320-40)/MONGODB_NODE_PROCESSES))):
# MONGODB_MAX_POOL_SIZE=3

AUTH_SECRET=generate-a-long-random-string
# Must include http:// or https:// (never bare localhost:3000 or domain only)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Optional: public site URL for absolute image links (production)
NEXT_PUBLIC_SITE_URL=https://marinamuseinternational.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated admin emails (full admin panel access)
ADMIN_EMAILS=admin@marinamuseinternational.com
ADMIN_PASSWORD=Admin@marinamuse

# Shown in footer & contact page (comma-separated)
CONTACT_EMAILS=info@marinamuseinternational.com

# PayPal checkout (sandbox or live). Webhook URL: https://your-domain/api/paypal/webhook
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# ShipGlobal label portal (https://labels.shipglobal.in). Paid orders are booked automatically.
# SHIPGLOBAL_EMAIL is the portal login, not the v2 dashboard password unless ShipGlobal says they match.
SHIPGLOBAL_EMAIL=
SHIPGLOBAL_PASSWORD=
# Carrier service code from the label portal, for example DHLECS, UPS, USPS, DPD
SHIPGLOBAL_SERVICE=DHLECS
SHIPGLOBAL_API_BASE=https://labels.shipglobal.in/api/v1
# SHIPGLOBAL_HSN=74199990
# SHIPGLOBAL_CSB5=1
# SHIPGLOBAL_IOSS=
# SHIPGLOBAL_SELLER_FIRST=Marina
# SHIPGLOBAL_SELLER_LAST=Muse

# Password reset OTP (SMTP)
SMTP_USER=info@marinamuseinternational.com
SMTP_PASS=your-smtp-password
SMTP_FROM=info@marinamuseinternational.com
SMTP_HOST=mail.marinamuseinternational.com
SMTP_PORT=587

# Optional: remote image host — must expose POST https://your-domain/upload (single = in .env!)
# Leave empty to save under public/uploads on the Next.js server.
KVM2_UPLOAD_URL=https://marinamuseinternational.com
KVM2_UPLOAD_TOKEN=

# Production deploy (KVM): npm ci && npm run build && npm run start
# Upload the full .next folder (especially .next/static/css). See nginx.example.conf.
# Do NOT run "npm run dev" on the live server.
# MongoDB on KVM: copy MONGODB_URI into .env.production.local (same folder as package.json),
# then npm run check:mongo (must OK), then pm2 restart your-app --update-env

# ── Marina AI: four agents (chat, voice, growth, WhatsApp). Check every service at /test (admin login in production).
# Leave a block blank and that agent falls back safely (catalogue-only replies, voice off, no Google data).

# Shared AI — Google Gemini API key from https://aistudio.google.com/apikey (an API key, not a Gemini app subscription)
GEMINI_API_KEY=
# Optional, default gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Owner alerts + daily report use the SMTP_* settings above. Comma-separated; defaults to ADMIN_EMAILS.
# OWNER_ALERT_EMAILS=
# Alert when a lead reaches this score (1–100, default 81) or this estimated deal value in USD (default 5000)
# AI_OWNER_ALERT_SCORE=81
# AI_OWNER_ALERT_VALUE_USD=5000

# Scheduled jobs. Send "Authorization: Bearer <CRON_SECRET>" to:
#   POST /api/ai/jobs            every 15 minutes (checkout/enquiry recovery follow-ups)
#   POST /api/ai/report/daily    once a day (owner report email)
CRON_SECRET=

# Agent 2 — Vapi (voice AI). Private API key from dashboard → API Keys.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# Vapi phone number (byo-phone-number on the Exotel SIP trunk) and the byo-sip-trunk credential id
VAPI_PHONE_NUMBER_ID=
VAPI_SIP_CREDENTIAL_ID=
# Shared secret Vapi sends as x-vapi-secret (or Bearer) to POST /api/ai/voice/webhook
VAPI_WEBHOOK_SECRET=
# Billable outbound callbacks (owner-approved, consent required). Keep false until tested.
VAPI_OUTBOUND_ENABLED=false
# Optional: Gemini model id for the voice assistant (defaults to GEMINI_MODEL); https://api.eu.vapi.ai for EU orgs
# VAPI_MODEL=
# VAPI_API_BASE=https://api.vapi.ai
# Only languages the Vapi voice/transcriber really supports: en,de,fr,es,it,nl,ar,tr,hi,ur
# VOICE_LANGUAGES=en
# Generic HMAC voice webhook for a non-Vapi provider (header x-marina-voice-signature)
# VOICE_PROVIDER=
# VOICE_WEBHOOK_SECRET=

# Agent 2 — Exotel (Indian business number). API key/token from my.exotel.com/apisettings.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# api.in.exotel.com (Mumbai) or api.exotel.com (Singapore)
EXOTEL_SUBDOMAIN=api.in.exotel.com
# ExoPhone in E.164, and the vSIP trunk that routes it to <VAPI_SIP_CREDENTIAL_ID>.sip.vapi.ai
EXOTEL_PHONE_NUMBER=
EXOTEL_TRUNK_SID=
# Random token for the missed-call StatusCallback: /api/ai/voice/webhook?provider=exotel&token=<EXOTEL_WEBHOOK_TOKEN>
EXOTEL_WEBHOOK_TOKEN=

# Agent 3 — Google service account (one for GA4 + Search Console). Either the whole key file (raw JSON or base64)…
GOOGLE_SERVICE_ACCOUNT_JSON=
# …or the two fields (private key with \n line breaks)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GA4 numeric property id (Admin → Property details), not the G- id
GA4_PROPERTY_ID=
# Server-side purchase conversions (Measurement Protocol): web stream G- id + API secret
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Browser tag (loads only after cookie consent). Rebuild after changing.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Search Console property: sc-domain:marinamuseinternational.com or https://marinamuseinternational.com/
SEARCH_CONSOLE_SITE_URL=
# Not integrated (feed is served at /feeds/google.xml for scheduled fetch)
# MERCHANT_CENTER_ID=


# WhatsApp Business app coexistence. Leave the three flags false until written approval.
# Do not put the app secret in frontend code. Restart the server after changing these.
META_APP_ID=1588276335845243
META_APP_SECRET=
META_CONFIG_ID=1760993601871515
META_GRAPH_API_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=
WHATSAPP_COEXISTENCE_ENABLED=false
WHATSAPP_PRODUCTION_ONBOARDING_APPROVED=false
WHATSAPP_OUTBOUND_ENABLED=false
# Agent 4 — WhatsApp Cloud API (System User permanent token with whatsapp_business_messaging + whatsapp_business_management).
# If left empty, the token stored by Embedded Signup (encrypted with AUTH_SECRET) is used.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Approved template for consented follow-ups outside the 24-hour window, and its language code
WHATSAPP_FOLLOWUP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
