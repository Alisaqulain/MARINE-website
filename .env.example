# Marina Muse International — environment variables. GENERATED by `npm run docs:env` from lib/ai/env-registry.ts.
# Copy to .env.local (development) or .env.production.local (server). Never commit real values.
# Setup steps for every variable: docs/phase2/ENVIRONMENT_SETUP.md. Live status: /test (admin login).

# ── Database (MongoDB Atlas) ──
# Copy the SRV connection string and insert the database user's password. [Required, secret]
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
# Only if SRV DNS fails on the server; overrides MONGODB_URI. [Optional, secret]
# MONGODB_URI_STANDARD=
# Database name, e.g. marina_muse. [Required]
MONGODB_DB_NAME=marina_muse
# 1 to prefer IPv4 (recommended on the VPS). [Optional]
MONGODB_PREFER_IPV4=1
# Number of app processes sharing the Atlas connection limit (e.g. 2 under PM2). [Optional]
MONGODB_NODE_PROCESSES=2
# Connections reserved for other clients (default 40). [Optional]
MONGODB_EXTERNAL_CLIENTS=40
# Override the per-process pool size. [Optional]
# MONGODB_MAX_POOL_SIZE=
# Total Atlas connection budget (advanced). [Optional]
# MONGODB_CONNECTION_BUDGET=
# Advanced connection mode switch (1/0). Leave unset unless troubleshooting. [Optional]
# MONGODB_DIRECT=
# 1 = use SRV only (advanced). [Optional]
# MONGODB_SRV_ONLY=
# 1/0 to force or skip the SRV fallback (advanced). [Optional]
# MONGODB_SKIP_SRV_FALLBACK=
# 0 disables the Stable API declaration (advanced). [Optional]
# MONGODB_SERVER_API=
# 1/0 Node autoSelectFamily for IPv4/IPv6 (advanced). [Optional]
# MONGODB_AUTO_SELECT_FAMILY=
# 1 forces IPv4 lookups (advanced). [Optional]
# MONGODB_FORCE_IPV4=
# Only for direct-shard connections (advanced). [Optional]
# MONGODB_REPLICA_SET=

# ── Site & sign-in ──
# Long random string. Also encrypts the stored WhatsApp token — changing it makes that token unreadable. [Required, secret]
AUTH_SECRET=
# Full site URL, e.g. https://marinamuseinternational.com (no trailing characters). [Required]
AUTH_URL=http://localhost:3000
# Same as AUTH_URL. [Required]
NEXTAUTH_URL=http://localhost:3000
# Public site URL used for absolute links, feeds and webhooks. [Optional]
NEXT_PUBLIC_SITE_URL=https://marinamuseinternational.com
# Web OAuth client for “Sign in with Google”. [Optional]
GOOGLE_CLIENT_ID=
# Client secret of that OAuth client. [Optional, secret]
GOOGLE_CLIENT_SECRET=
# Comma-separated admin emails. [Required]
ADMIN_EMAILS=admin@marinamuseinternational.com
# Strong admin password. Never reuse the sample value. [Required, secret]
ADMIN_PASSWORD=
# Shop time zone for sale dates, default +05:30 (India). [Optional]
# NEXT_PUBLIC_SHOP_UTC_OFFSET=+05:30
# Shown on the site (currently read from lib/company). [Optional]
CONTACT_EMAILS=info@marinamuseinternational.com

# ── Email & owner alerts ──
# e.g. mail.marinamuseinternational.com [Required for this feature]
SMTP_HOST=mail.marinamuseinternational.com
# 587 (STARTTLS) or 465 (SSL). [Required for this feature]
SMTP_PORT=587
# Mailbox address used to send. [Required for this feature]
SMTP_USER=info@marinamuseinternational.com
# Password for SMTP_USER. [Required for this feature, secret]
SMTP_PASS=
# Kept for compatibility; the sender is set in lib/password-otp-email. [Optional]
# SMTP_FROM=info@marinamuseinternational.com
# Who receives lead/missed-call alerts and the daily report (defaults to ADMIN_EMAILS). [Optional]
# OWNER_ALERT_EMAILS=
# Lead score (1–100) that alerts the owner. Default 81. [Optional]
# AI_OWNER_ALERT_SCORE=
# Estimated deal value (USD) that alerts the owner. Default 5000. [Optional]
# AI_OWNER_ALERT_VALUE_USD=
# Optional: order confirmation emails via Resend. [Optional, secret]
# RESEND_API_KEY=
# Sender for order emails sent through Resend. [Optional]
# ORDER_EMAIL_FROM=

# ── Payments & shipping (existing store) ──
# Client ID of the live (or sandbox) app. [Required for this feature]
PAYPAL_CLIENT_ID=
# Secret of that app. [Required for this feature, secret]
PAYPAL_CLIENT_SECRET=
# sandbox or live. [Required for this feature]
PAYPAL_MODE=sandbox
# Webhook ID shown after creating it. [Required for this feature]
PAYPAL_WEBHOOK_ID=
# Only if Razorpay checkout is used. [Optional]
# RAZORPAY_KEY_ID=
# Key secret. [Optional, secret]
# RAZORPAY_KEY_SECRET=
# Label-portal login email. [Required for this feature]
SHIPGLOBAL_EMAIL=
# Password for SHIPGLOBAL_EMAIL. [Required for this feature, secret]
SHIPGLOBAL_PASSWORD=
# e.g. DHLECS. [Optional]
SHIPGLOBAL_SERVICE=DHLECS
# Default https://labels.shipglobal.in/api/v1. [Optional]
SHIPGLOBAL_API_BASE=https://labels.shipglobal.in/api/v1
# HSN code for customs (optional). [Optional]
# SHIPGLOBAL_HSN=
# 1 for CSB-V shipments (optional). [Optional]
# SHIPGLOBAL_CSB5=
# EU IOSS number (optional). [Optional]
# SHIPGLOBAL_IOSS=
# Seller first name on labels (optional). [Optional]
# SHIPGLOBAL_SELLER_FIRST=
# Seller last name on labels (optional). [Optional]
# SHIPGLOBAL_SELLER_LAST=
# Remote image host exposing POST /upload; empty = save under public/uploads. [Optional]
KVM2_UPLOAD_URL=https://marinamuseinternational.com
# Bearer token for that upload endpoint. [Optional, secret]
KVM2_UPLOAD_TOKEN=
# 1 = never use the remote image host (local development). [Optional]
# KVM2_UPLOAD_SKIP=

# ── Gemini (shared AI) ──
# Create an API key. A Gemini app/Pro subscription is not an API key. Enable billing for production quotas. [Required, secret]
GEMINI_API_KEY=
# Model id; default gemini-2.5-flash. [Optional]
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated agents to switch off: chat, voice, growth, whatsapp. Empty = all on. [Optional]
# AI_AGENTS_DISABLED=

# ── Scheduled jobs ──
# Send as Authorization: Bearer … from your scheduler to /api/ai/jobs (every 15 min) and /api/ai/report/daily (daily). [Required, secret]
CRON_SECRET=

# ── Vapi (voice AI) ──
# Use the PRIVATE key, not the public key. [Required for this feature, secret]
VAPI_API_KEY=
# Create an assistant, then Admin → Marina AI → Health → “Sync Vapi assistant”. [Required for this feature]
VAPI_ASSISTANT_ID=
# Vapi sends it as x-vapi-secret to /api/ai/voice/webhook (the Sync button configures this). [Required for this feature, secret]
VAPI_WEBHOOK_SECRET=
# Create a byo-phone-number for your ExoPhone on the SIP trunk credential. [Required for this feature]
VAPI_PHONE_NUMBER_ID=
# BYO SIP trunk credential pointing at the Exotel gateway. [Required for this feature]
VAPI_SIP_CREDENTIAL_ID=
# true only after testing — enables owner-approved, billable callbacks. [Optional]
VAPI_OUTBOUND_ENABLED=false
# Gemini model for the assistant (defaults to GEMINI_MODEL). [Optional]
# VAPI_MODEL=
# https://api.vapi.ai (default) or https://api.eu.vapi.ai for EU orgs. [Optional]
VAPI_API_BASE=https://api.vapi.ai
# Languages your voice/transcriber really supports, e.g. en,hi. [Optional]
VOICE_LANGUAGES=en
# Only for a non-Vapi provider using the generic HMAC webhook. [Optional]
# VOICE_PROVIDER=
# HMAC secret for the generic voice webhook (non-Vapi). [Optional, secret]
# VOICE_WEBHOOK_SECRET=

# ── Exotel (telephony) ──
# API key of your Exotel account. [Required for this feature]
EXOTEL_API_KEY=
# API token for that key. [Required for this feature, secret]
EXOTEL_API_TOKEN=
# Your account SID. [Required for this feature]
EXOTEL_ACCOUNT_SID=
# api.in.exotel.com (Mumbai) or api.exotel.com (Singapore). [Optional]
EXOTEL_SUBDOMAIN=api.in.exotel.com
# The ExoPhone customers call, in E.164 (+91…). Requires KYC. [Required for this feature]
EXOTEL_PHONE_NUMBER=
# Trunk routing the ExoPhone to <VAPI_SIP_CREDENTIAL_ID>.sip.vapi.ai. vSIP must be enabled by Exotel. [Required for this feature]
EXOTEL_TRUNK_SID=
# Put in the ExoPhone StatusCallback URL: /api/ai/voice/webhook?provider=exotel&token=… [Required for this feature, secret]
EXOTEL_WEBHOOK_TOKEN=

# ── WhatsApp Cloud API ──
# Permanent System User token with whatsapp_business_messaging + whatsapp_business_management. Optional if Embedded Signup stored a token. [Required for this feature, secret]
WHATSAPP_ACCESS_TOKEN=
# Numeric phone-number ID (not the phone number). Filled automatically after a coexistence signup. [Required for this feature]
WHATSAPP_PHONE_NUMBER_ID=
# Numeric WABA ID. [Required for this feature]
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Name of an APPROVED template for consented follow-ups outside the 24-hour window. [Optional]
WHATSAPP_FOLLOWUP_TEMPLATE=
# Language code of that template, e.g. en or en_US. [Optional]
WHATSAPP_TEMPLATE_LANGUAGE=en
# 1588276335845243 (supplied). [Required for this feature]
META_APP_ID=1588276335845243
# Server only. Verifies webhook signatures and exchanges signup codes. [Required for this feature, secret]
META_APP_SECRET=
# Optional; defaults to META_APP_SECRET. [Optional, secret]
# META_WEBHOOK_APP_SECRET=
# Any random string; Meta echoes it during webhook verification. [Required for this feature, secret]
META_WEBHOOK_VERIFY_TOKEN=
# Default v26.0. [Optional]
META_GRAPH_API_VERSION=v26.0

# ── WhatsApp coexistence ──
# 1760993601871515 (supplied): Embedded Signup v4 configuration. [Required for this feature]
META_CONFIG_ID=1760993601871515
# true to open Embedded Signup (test mode needs WHATSAPP_COEXISTENCE_TEST_NUMBER). [Optional]
WHATSAPP_COEXISTENCE_ENABLED=false
# The only number that may be onboarded before production approval (10 digits = India). [Optional]
WHATSAPP_COEXISTENCE_TEST_NUMBER=
# true only after written approval to onboard the client's live number. [Optional]
WHATSAPP_PRODUCTION_ONBOARDING_APPROVED=false
# true to let the AI send replies (inside the 24-hour window). [Optional]
WHATSAPP_OUTBOUND_ENABLED=false

# ── Google Analytics & Search Console ──
# Paste the JSON (or base64 of it). Enable the Analytics Data API and Search Console API in that project. [Required for this feature, secret]
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to the JSON: the account's email. [Optional]
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Alternative to the JSON: the PEM key with \n line breaks. [Optional, secret]
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Numeric property ID (not the G- ID). Add the service-account email as Viewer in Property access management. [Required for this feature]
GA4_PROPERTY_ID=
# G-XXXXXXX, for server-side purchase events. [Optional]
GA4_MEASUREMENT_ID=
# Secret for server-side purchase events. [Optional, secret]
GA4_API_SECRET=
# Browser tag (loads after cookie consent). Rebuild after changing. [Optional]
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# sc-domain:marinamuseinternational.com (domain property) or https://marinamuseinternational.com/ (URL prefix). Add the service-account email under Settings → Users and permissions. [Required for this feature]
SEARCH_CONSOLE_SITE_URL=
