MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=marina_muse
# Do NOT set MONGODB_DIRECT=0 on Linux VPS — it blocks direct shards (use SRV only if you set MONGODB_SRV_ONLY=1)
MONGODB_PREFER_IPV4=1

AUTH_SECRET=generate-a-long-random-string
# Must include http:// or https:// (never bare localhost:3000 or domain only)
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Optional: public site URL for absolute image links (production)
NEXT_PUBLIC_SITE_URL=https://marinamuseinternational.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated admin emails (full admin panel access)
ADMIN_EMAILS=marinamuseinternational@gmail.com,muaasiyainternational@gmail.com
ADMIN_PASSWORD=Admin@marinamuse

# Shown in footer & contact page (comma-separated)
CONTACT_EMAILS=muaasiyainternational@gmail.com,marinamuseinternational@gmail.com

# Password reset OTP (Gmail: use App Password)
SMTP_USER=ibrahiminternational3112026@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=ibrahiminternational3112026@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Optional: remote image host — must expose POST https://your-domain/upload (single = in .env!)
# Leave empty to save under public/uploads on the Next.js server.
KVM2_UPLOAD_URL=https://marinamuseinternational.com
KVM2_UPLOAD_TOKEN=

# Production deploy (KVM): npm ci && npm run build && npm run start
# Upload the full .next folder (especially .next/static/css). See nginx.example.conf.
# Do NOT run "npm run dev" on the live server.
# MongoDB on KVM: copy MONGODB_URI into .env.production.local (same folder as package.json),
# then npm run check:mongo (must OK), then pm2 restart your-app --update-env
